{
  "name": "svg-editor",
  "version": "0.1.0",
  "description": "Lab1 Phase 1 - SVG editor CLI (command pattern + composite)",
  "license": "MIT",
  "private": true,
  "bin": {
    "svg-editor": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/cli/main.js",
